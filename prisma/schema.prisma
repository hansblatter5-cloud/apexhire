generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// Enums

enum Role {
  USER
  ADMIN
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  REJECTED
  ACCEPTED
}

enum ImportSource {
  MANUAL
  EXTENSION
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum AuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELETED
  IMPORTED
}

enum ResumeSection {
  SUMMARY
  EXPERIENCE
  EDUCATION
  PROJECTS
  SKILLS
}

// Identity (Auth.js, JWT sessions)

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  // Days to wait after APPLIED before the follow-up reminder fires.
  followUpDays  Int       @default(7)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  applications  Application[]
  resumes       Resume[]
  auditLogs     AuditLog[]
  stageEvents   StageEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Pipeline

model Application {
  id            String            @id @default(cuid())
  userId        String
  company       String
  title         String
  location      String?
  salaryText    String?
  url           String?
  description   String?           @db.Text
  notes         String?           @db.Text
  source        ImportSource      @default(MANUAL)
  status        ApplicationStatus @default(SAVED)

  // Fractional ordering inside a column. A drop sets position to the
  // midpoint of the new neighbours, so a move writes a single row.
  position      Float             @default(0)

  // Optimistic concurrency. Incremented on every write; mutations must
  // include the version they read.
  version       Int               @default(1)

  appliedDate   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders     Reminder[]
  auditLogs     AuditLog[]
  stageEvents   StageEvent[]
  embedding     JobEmbedding?

  // Import de-duplication. NULL urls (manual entries) never collide.
  @@unique([userId, url])
  @@index([userId, status, position])
}

model Reminder {
  id               String         @id @default(cuid())
  applicationId    String
  qstashMessageId  String?        @unique
  status           ReminderStatus @default(SCHEDULED)
  scheduledFor     DateTime
  sentAt           DateTime?
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@index([status, scheduledFor])
}

model AuditLog {
  id            String             @id @default(cuid())
  userId        String
  applicationId String?
  action        AuditAction
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  metadata      Json?
  createdAt     DateTime           @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([applicationId])
}

// Funnel analytics in Postgres for v1 (replaces ClickHouse until volume
// justifies it). One row per status transition.
model StageEvent {
  id                     String             @id @default(cuid())
  userId                 String
  applicationId          String
  fromStatus             ApplicationStatus?
  toStatus               ApplicationStatus
  secondsInPreviousStage Int?
  occurredAt             DateTime           @default(now())

  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([applicationId])
}

// Resumes and embeddings
// Prisma Client cannot read or write `vector` columns. Embeddings are
// written and queried with $executeRaw / $queryRaw. The HNSW indexes are
// added by hand in the init migration (see DAY1.md).

model Resume {
  id        String    @id @default(cuid())
  userId    String
  name      String
  fileKey   String
  mimeType  String
  sizeBytes Int
  isBase    Boolean   @default(false)
  parsedAt  DateTime?
  createdAt DateTime  @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks    ResumeBlock[]

  @@index([userId])
}

model ResumeBlock {
  id        String                       @id @default(cuid())
  resumeId  String
  section   ResumeSection
  heading   String?
  content   String                       @db.Text
  position  Int
  embedding Unsupported("vector(1536)")?

  resume    Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model JobEmbedding {
  id            String                       @id @default(cuid())
  applicationId String                       @unique
  model         String                       @default("text-embedding-3-small")
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}